<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="org.example.sgef_petalex_v_09.controllers.ClientesController"
    fx:id="root"
    styleClass="root"
    prefWidth="1024" prefHeight="768">

    <!-- Botón Volver -->
    <Button fx:id="btnBack"
        onAction="#onBack"
        styleClass="back-button"
        AnchorPane.topAnchor="10"
        AnchorPane.leftAnchor="10">
        <graphic>
            <ImageView fitWidth="16" preserveRatio="true">
                <image>
                    <Image url="@../images/icon_back.png" />
                </image>
            </ImageView>
        </graphic>
        <text>
            <String fx:value="Volver" />
        </text>
    </Button>

    <!-- Título -->
    <Label text="Clientes"
        styleClass="header-title"
        AnchorPane.topAnchor="10"
        AnchorPane.leftAnchor="120" />

    <!-- Toolbar: acciones y filtros -->
    <VBox spacing="5"
        AnchorPane.topAnchor="50"
        AnchorPane.leftAnchor="10"
        AnchorPane.rightAnchor="10">

        <!-- Botones de acción -->
        <HBox spacing="10" styleClass="toolbar-buttons">
            <Button fx:id="btnNuevo" text="Nuevo Cliente" onAction="#onNuevo"
                styleClass="toolbar-button" />
            <Button fx:id="btnEditar" text="Editar Cliente" onAction="#onEditar"
                styleClass="toolbar-button" disable="true" />
            <Button fx:id="btnEstado" text="Cambiar Estado" onAction="#onEstado"
                styleClass="toolbar-button" disable="true" />
        </HBox>

        <!-- Filtros de búsqueda -->
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar-filters">
            <TextField fx:id="txtBuscarIdentificador" layoutX="100" layoutY="150" prefWidth="200.0"
                promptText="Identificador Empresarial" />
            <ComboBox fx:id="cbEstado" layoutX="100" layoutY="250" prefWidth="200.0"
                promptText="Estado" />
        </HBox>
    </VBox>

    <!-- Tabla de clientes -->
    <TableView fx:id="tablaClientes"
        styleClass="table-clientes"
        AnchorPane.topAnchor="140"
        AnchorPane.leftAnchor="15"
        AnchorPane.rightAnchor="10"
        AnchorPane.bottomAnchor="10">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="80" />
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200" />
            <TableColumn fx:id="colIdentificador" text="Identificador" prefWidth="130" />
            <TableColumn fx:id="colPais" text="País" prefWidth="100" />
            <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="250" />
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="150" />
            <TableColumn fx:id="colCorreo" text="Correo" prefWidth="200" />
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100" />
            <TableColumn fx:id="colFechaModificacion" text="Fecha Modificación" prefWidth="150" />
            <TableColumn fx:id="colUsuarioModificacion" text="Modificado por" prefWidth="120" />
        </columns>
    </TableView>

</AnchorPane>