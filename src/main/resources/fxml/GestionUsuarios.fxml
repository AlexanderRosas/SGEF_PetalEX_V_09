<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="org.example.sgef_petalex_v_09.controllers.GestionUsuariosController"
    styleClass="root"
    prefWidth="800" prefHeight="700">

    <!-- Toolbar: acciones -->
    <VBox spacing="5" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <HBox spacing="10" styleClass="toolbar-buttons">
            <Button fx:id="btnNuevo"
                text="Nuevo"
                onAction="#onNuevo"
                styleClass="toolbar-button">
                <graphic>
                    <ImageView fitWidth="16" preserveRatio="true">
                        <image>
                            <Image url="@../images/icon_new.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="btnEditar"
                text="Editar"
                onAction="#onEditar"
                styleClass="toolbar-button"
                disable="true">
                <graphic>
                    <ImageView fitWidth="16" preserveRatio="true">
                        <image>
                            <Image url="@../images/icon_role.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <!-- Cambiado fx:id a btnEstado para que coincida con tu controlador -->
            <Button fx:id="btnEstado"
                text="Cambiar estado"
                onAction="#onEstado"
                styleClass="toolbar-button"
                disable="true">
                <graphic>
                    <ImageView fitWidth="16" preserveRatio="true">
                        <image>
                            <Image url="@../images/icon_reactivate.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar-filters">
            <TextField fx:id="txtBuscarNombreNatural" layoutX="100" layoutY="100" prefWidth="200.0"
                promptText="Nombre Natural" />
            <TextField fx:id="txtBuscarNombreUsuario" layoutX="100" layoutY="100" prefWidth="200.0"
                promptText="Nombre de Usuario" />
            <TextField fx:id="txtBuscarCedula" layoutX="100" layoutY="150" prefWidth="200.0"
                promptText="Número de Cédula" />
            <TextField fx:id="txtBuscarCorreo" layoutX="100" layoutY="200" prefWidth="200.0"
                promptText="Correo Electrónico" />
            <ComboBox fx:id="cbEstado"
                promptText="Estado"
                styleClass="filter-combo" />
        </HBox>

    </VBox>

    <!-- Tabla de Usuarios: fx:id corregido a 'tablaUsuarios' -->
    <Label fx:id="lblNoUsuarios"
        text="No se encontraron Usuarios"
        styleClass="no-usuarios-label"
        visible="false"
        managed="false"
        AnchorPane.topAnchor="120.0"
        AnchorPane.leftAnchor="50.0"
        AnchorPane.rightAnchor="50.0" />
    <TableView fx:id="tablaUsuarios"
        editable="true"
        styleClass="table-clientes"
        AnchorPane.topAnchor="80"
        AnchorPane.leftAnchor="10"
        AnchorPane.rightAnchor="10"
        AnchorPane.bottomAnchor="10">
        <columns>
            <TableColumn fx:id="colNombreNatural" text="Nombre Natural" prefWidth="140" />
            <TableColumn fx:id="colCedula" text="Número de Cédula" prefWidth="100" />
            <TableColumn fx:id="colUsuario" text="Nombre de Usuario" prefWidth="120" />
            <TableColumn fx:id="colCorreo" text="Correo Electrónico" prefWidth="180" />
            <TableColumn fx:id="colRol" text="Rol" prefWidth="110" />
            <TableColumn fx:id="colPermisos" text="Permisos" prefWidth="200" />
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="80" />
            <TableColumn fx:id="colFechaModificacion" text="Fecha de Modificación" prefWidth="150" />
            <TableColumn fx:id="colUsuarioModificador" text="Usuario Modificador" prefWidth="140" />

        </columns>
    </TableView>

</AnchorPane>