<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.sgef_petalex_v_09.controllers.VentasController"
            styleClass="root"
            prefWidth="1024" prefHeight="768">

    <!-- Botón Volver -->
    <Button fx:id="btnBack"
            text="← Volver"
            styleClass="back-button"
            onAction="#onBack"
            AnchorPane.topAnchor="10"
            AnchorPane.leftAnchor="10"/>

    <!-- Título -->
    <Label text="Ventas"
           styleClass="header-title"
           AnchorPane.topAnchor="10"
           AnchorPane.leftAnchor="120"/>

    <!-- Encabezado Campos Fijos -->
    <HBox spacing="20"
          AnchorPane.topAnchor="50"
          AnchorPane.leftAnchor="10"
          AnchorPane.rightAnchor="10">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <Label text="Punto Emisión:"/>
        <TextField fx:id="txtPuntoEmision" editable="false"/>
        <Label text="Fecha:"/>
        <TextField fx:id="txtFecha" editable="false"/>
        <Label text="Sucursal:"/>
        <TextField fx:id="txtSucursal" editable="false"/>
    </HBox>

    <!-- Rango de fechas para emitir factura -->
    <HBox spacing="10"
          alignment="CENTER_LEFT"
          AnchorPane.topAnchor="90"
          AnchorPane.leftAnchor="10"
          AnchorPane.rightAnchor="10">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <Label text="Desde:"/>
        <DatePicker fx:id="dpFechaDesde"/>
        <Label text="Hasta:"/>
        <DatePicker fx:id="dpFechaHasta"/>
        <Button fx:id="btnExportarFactura"
                text="Emitir Facturas"
                onAction="#onExportarFactura"
                styleClass="toolbar-button"/>
    </HBox>

    <!-- Botones de acción -->
    <HBox spacing="10"
          AnchorPane.topAnchor="130"
          AnchorPane.leftAnchor="10"
          AnchorPane.rightAnchor="10">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <Button fx:id="btnAnularVenta"
                text="Anular Venta"
                onAction="#onAnularVenta"
                styleClass="toolbar-button"
                disable="true"/>
        <Button fx:id="btnRecaudar"
                text="Recaudar"
                onAction="#onRecaudar"
                styleClass="toolbar-button"
                disable="true"/>
        <Button fx:id="btnEliminar"
                text="Eliminar"
                onAction="#onEliminar"
                styleClass="toolbar-button"
                disable="true"/>
    </HBox>

    <!-- Tabla de Ventas -->
    <TableView fx:id="tablaVentas"
               AnchorPane.topAnchor="170"
               AnchorPane.leftAnchor="10"
               AnchorPane.rightAnchor="10"
               AnchorPane.bottomAnchor="10"
               tableMenuButtonVisible="false">
        <columns>
            <TableColumn fx:id="colId"       text="ID"            prefWidth="80"/>
            <TableColumn fx:id="colDestino"  text="Tipo Destino"  prefWidth="120"/>
            <TableColumn fx:id="colServicio" text="Servicio"      prefWidth="120"/>
            <TableColumn fx:id="colCliente"  text="Cliente"       prefWidth="200"/>
            <TableColumn fx:id="colDetalle"  text="Detalle"       prefWidth="250"/>
            <TableColumn fx:id="colPrecio"   text="Precio"        prefWidth="100"/>
            <TableColumn fx:id="colIva"      text="IVA"           prefWidth="80"/>
            <TableColumn fx:id="colTotal"    text="Total"         prefWidth="100"/>
            <TableColumn fx:id="colEstado"   text="Estado"        prefWidth="100"/>
            <TableColumn fx:id="colFecha"    text="Fecha"         prefWidth="120"/>
            <TableColumn fx:id="colUsuarioResponsable" text="Usuario Responsable" prefWidth="150"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</AnchorPane>
